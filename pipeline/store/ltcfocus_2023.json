{
 "year": 2023,
 "source": "LTCFocus, Brown University School of Public Health, facility, state, and national files for 2023 (ltcfocus.org).",
 "notes": [
  "Resident figures are for residents in the home on the first Thursday in April 2023. Occupancy, payer, and acuity figures are from the home's inspection in LTCFocus's 2023 file (late 2022 or 2023). Nurse practitioner or physician assistant hours cover all of 2023. Pressure ulcers are CMS figures for the second quarter of 2023.",
  "Rhode Island and U.S. averages are LTCFocus's own state and national figures, except the Rhode Island acuity average (11.7), which leaves out 23 homes that LTCFocus lists as 0; LTCFocus's own state figure (8.33) counts the zeros.",
  "\"too few\" means between 1 and 10 residents had this, so LTCFocus does not publish the number."
 ],
 "measures": [
  {
   "key": "occpct",
   "label": "Occupancy",
   "kind": "pct",
   "explain": "Share of beds filled at the home's inspection in LTCFocus's 2023 file (late 2022 or 2023).",
   "ri": 81.94,
   "us": 74.49
  },
  {
   "key": "paymcaid",
   "label": "Medicaid pays",
   "kind": "pct",
   "explain": "Residents whose care was mainly paid for by Medicaid at that inspection.",
   "ri": 62.43,
   "us": 62.6
  },
  {
   "key": "paymcare",
   "label": "Medicare pays",
   "kind": "pct",
   "explain": "Residents whose care was mainly paid for by Medicare at that inspection. Medicare pays for short stays after a hospital stay, not long-term care.",
   "ri": 6.9,
   "us": 12.48
  },
  {
   "key": "anymdex_pbj",
   "label": "Nurse practitioner or physician assistant",
   "kind": "yn",
   "explain": "Whether the home's payroll records show any nurse practitioner or physician assistant hours in 2023. Those who work for an outside medical practice are not counted, so “No” does not mean residents never see one. The Rhode Island and U.S. figures are the share of homes with hours.",
   "ri": 24.0,
   "us": null
  },
  {
   "key": "acuindex2",
   "label": "Acuity index",
   "kind": "num",
   "explain": "A score from the home's inspection for how much care residents need. It counts residents who need help eating, using the toilet, or moving; residents who are bedfast; residents who get treatments such as breathing care, IV therapy, tube feeding, or physical therapy; and residents with dementia or a psychiatric diagnosis. Higher means more care needed. Rhode Island homes range from about 9 to 13.",
   "ri": 11.7,
   "us": null
  },
  {
   "key": "avgage",
   "label": "Average age of residents",
   "kind": "num",
   "explain": "Average age of the people living in the home.",
   "ri": 80.44,
   "us": 77.07
  },
  {
   "key": "avgadl_mds3",
   "label": "Help needed with daily activities",
   "kind": "num",
   "explain": "Average score for 7 daily activities: moving in bed, getting in and out of bed, walking on the unit, dressing, eating, using the toilet, and personal hygiene. 0 means fully independent and 28 means fully dependent on staff.",
   "ri": 15.08,
   "us": 16.27
  },
  {
   "key": "pctunder65",
   "label": "Residents under 65",
   "kind": "pct",
   "explain": "Residents younger than 65.",
   "ri": 10.97,
   "us": 17.27
  },
  {
   "key": "pctalz_dem",
   "label": "Residents with dementia",
